<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 구글 드라이브 백업 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 앱 안에서 새 버전 APK 설치 화면을 띄우기 위해 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- allowBackup/dataExtractionRules: 안드로이드 자동 백업·기기 간 이전으로 가계부 데이터가 복사되지 않도록 막는다.
         백업은 앱의 구글 드라이브 백업 기능으로만 한다. -->
    <application
        android:name=".PiggyBankApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher_coin"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_coin"
        android:supportsRtl="true"
        android:theme="@style/Theme.PiggyBank"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 홈 화면 아이콘(설정 → 디자인 → 앱 아이콘). 아이콘마다 alias 하나, 고른 것만 켠다(AppIconManager).
             이름은 model/AppIcon.kt의 aliasName과 같아야 한다. 처음에는 동전 돼지만 켜져 있다. -->
        <activity-alias
            android:name=".IconCoin"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_coin"
            android:roundIcon="@mipmap/ic_launcher_coin"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconPeek"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_peek"
            android:roundIcon="@mipmap/ic_launcher_peek"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBigSnout"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bigsnout"
            android:roundIcon="@mipmap/ic_launcher_bigsnout"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconWink"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_wink"
            android:roundIcon="@mipmap/ic_launcher_wink"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconSleepy"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_sleepy"
            android:roundIcon="@mipmap/ic_launcher_sleepy"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBank"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bank"
            android:roundIcon="@mipmap/ic_launcher_bank"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconHeart"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_heart"
            android:roundIcon="@mipmap/ic_launcher_heart"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconBall"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ball"
            android:roundIcon="@mipmap/ic_launcher_ball"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IconGoldCoin"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_coinface"
            android:roundIcon="@mipmap/ic_launcher_coinface"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 내려받은 업데이트 APK를 설치 화면에 넘겨주기 위한 파일 공유 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
